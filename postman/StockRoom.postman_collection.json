{
  "info": {
    "_postman_id": "stockroom-api-collection",
    "name": "StockRoom API",
    "description": "Sample collection for API automation against StockRoom. Against the protected Vercel deploy, set collection variable vercelBypassSecret (do not commit the real value).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const secret = pm.collectionVariables.get('vercelBypassSecret');",
          "if (secret) {",
          "  pm.request.headers.upsert({",
          "    key: 'x-vercel-protection-bypass',",
          "    value: secret",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Reset store",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/test/reset"
      }
    },
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health"
      }
    },
    {
      "name": "Login standard",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "pm.collectionVariables.set('token', json.token);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"standard\",\n  \"password\": \"password123\"\n}"
        },
        "url": "{{baseUrl}}/api/auth"
      }
    },
    {
      "name": "List products",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/products"
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:43124" },
    { "key": "token", "value": "" },
    { "key": "vercelBypassSecret", "value": "" }
  ]
}
